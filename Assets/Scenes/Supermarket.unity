  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Label
  text: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415 \u0412 \u0428\u041B\u0415\u041C\u0415\n\u0421\u0442\u0438\u043A \u0432\u043F\u0435\u0440\u0451\u0434 - \u0434\u0443\u0433\u0430 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430,\n\u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C - \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F\n\u0421\u0442\u0438\u043A \u0432\u043B\u0435\u0432\u043E/\u0432\u043F\u0440\u0430\u0432\u043E - \u043F\u043E\u0432\u043E\u0440\u043E\u0442\nGrip/\u0442\u0440\u0438\u0433\u0433\u0435\u0440 - \u0432\u0437\u044F\u0442\u044C / \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C\nX \u0438\u043B\u0438 Y - \u0437\u0430\u043A\u0430\u0437 \u043D\u0430 \u043B\u0435\u0432\u043E\u0439 \u0440\u0443\u043A\u0435\n\u041A\u043D\u043E\u043F\u043A\u0430 A - \u0440\u0435\u0441\u0442\u0430\u0440\u0442 \u043F\u043E\u0441\u043B\u0435 \u0444\u0438\u043D\u0430\u043B\u0430\n\n\u0411\u0415\u0417 \u0428\u041B\u0415\u041C\u0410\nWASD - \u0445\u043E\u0434\u0438\u0442\u044C, \u043C\u044B\u0448\u044C - \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\n\u041B\u041A\u041C - \u0432\u0437\u044F\u0442\u044C / \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C\n\u041A\u043E\u043B\u0451\u0441\u0438\u043A\u043E - \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0440\u0443\u043A\u0438\nShift - \u0431\u0435\u0433\n\nEsc \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044E - \u043F\u0430\u0443\u0437\u0430 \u0438 \u0432\u044B\u0445\u043E\u0434"
  size: 0.1
  color: {r: 0.8, g: 0.95, b: 1, a: 1}
  billboard: 0
  anchor: 4
  alignment: 1
